{
  "source_id": "libero",
  "display_name": "Libero",
  "base_url": "https://example.com/libero",
  "discovery": {
    "type": "html",
    "front_page_url_pattern": "https://example.com/libero/{date}"
  },
  "selectors": {
    "front_page_image": ".frontpage img",
    "article_blocks": ".cover-headline, .cover-subheadline"
  },
  "storage": {
    "folder_pattern": "data/raw/libero/{date}/"
  },
  "ocr_hints": {
    "language": "spa"
  },
  "schedule": {
    "timezone": "America/Lima",
    "run_after": "05:30"
  }
}
